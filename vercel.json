{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/automation-gmail-watch",
      "destination": "/api/automation-gmail?__pjsdas_gmail_route=watch"
    },
    {
      "source": "/api/gmail-push",
      "destination": "/api/automation-gmail?__pjsdas_gmail_route=push"
    },
    {
      "source": "/api/access",
      "destination": "/api/health-auth?mode=access"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp-auth",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/today",
      "destination": "/"
    },
    {
      "source": "/today/agenda",
      "destination": "/"
    },
    {
      "source": "/opportunities",
      "destination": "/"
    },
    {
      "source": "/opportunities/:id",
      "destination": "/"
    },
    {
      "source": "/capture",
      "destination": "/"
    },
    {
      "source": "/decisions",
      "destination": "/"
    },
    {
      "source": "/settings",
      "destination": "/"
    },
    {
      "source": "/history",
      "destination": "/"
    }
  ],
  "functions": {
    "api/automation-gmail.ts": {
      "maxDuration": 30
    }
  }
}
