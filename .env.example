VITE_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Browser-facing production topology.
# Exact values are deployment inputs; do not hard-code guessed personal domains in source.
# VITE_PJSDAS_CANONICAL_WEB_ORIGIN=https://pjsdas.example.com
# VITE_PJSDAS_CANONICAL_API_ORIGIN=https://api.pjsdas.example.com
# VITE_PJSDAS_LEGACY_WEB_ORIGINS=https://haohongfei2001-png.github.io

# Browser backend candidates. Canonical API is automatically preferred when configured.
# Add Vercel / Cloudflare fallback origins here without changing application code.
# VITE_PJSDAS_BACKEND_ORIGINS=https://pjsdas-remote-alpha.vercel.app

# Server-facing production topology.
# PJSDAS_CANONICAL_WEB_ORIGIN=https://pjsdas.example.com
# PJSDAS_CANONICAL_API_ORIGIN=https://api.pjsdas.example.com
# PJSDAS_LEGACY_WEB_ORIGINS=https://haohongfei2001-png.github.io
# Optional additional first-party browser origins:
# PJSDAS_ALLOWED_WEB_ORIGINS=https://preview.example.com

# Controlled audience. Default legacy preserves current behavior.
# Switch to allowlist only after pjsdas_access_grants contains the owner/beta accounts.
# PJSDAS_AUDIENCE_MODE=legacy

# Server-only. Required when transactional authority OR allowlist audience mode is active.
# Never expose this value through a VITE_* variable or client bundle.
# PJSDAS_SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# Activate only after explicit connected-workspace migration is complete and verified.
# Server runtime: PJSDAS_CONNECTED_AUTHORITY=transactional
# Frontend build: VITE_PJSDAS_CONNECTED_AUTHORITY=transactional
