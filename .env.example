VITE_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# Optional. Leave unset to use the current Vercel production backend.
# Add a comma-separated standby origin later without changing application code.
# VITE_PJSDAS_BACKEND_ORIGINS=https://primary.example,https://standby.example

# Server-only. Required only when activating the transactional connected-workspace API.
# Never expose this value through a VITE_* variable or client bundle.
# PJSDAS_SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# Activate only after an explicit connected-workspace migration has completed.
# Server runtime: PJSDAS_CONNECTED_AUTHORITY=transactional
# Frontend build: VITE_PJSDAS_CONNECTED_AUTHORITY=transactional
